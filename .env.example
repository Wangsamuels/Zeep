# Local development. On Heroku set these with `heroku config:set`.
# Vars marked [new] are not in the architecture doc; see README "Changes from the doc".

DATABASE_URL=postgres://zeep:zeep@localhost:5432/zeep
REDIS_URL=redis://localhost:6379
PORT=3000

# --- App and networking ---
NODE_ENV=development
ZEEP_ENV=testnet
LOG_LEVEL=info
PUBLIC_API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3001
RELAY_SHARED_SECRET=
REQUIRE_RELAY=false
INTERNAL_API_TOKEN=
DB_POOL_MAX=10
REDIS_TLS_REJECT_UNAUTHORIZED=false
STREAM_HEARTBEAT_SEC=15
UPSTREAM_TIMEOUT_MS=25000

# --- Zcash (watcher, payouts) ---
CHAIN_BACKEND=dev                 # [new] dev | rpc | lightclient (not built yet)
ZCASH_NETWORK=test
LIGHTWALLETD_URL=
ZEEP_RECEIVE_UA=
ZEEP_RECEIVE_UFVK=
ZEEP_WALLET_SEED=
ZEEP_WALLET_ACCOUNT=0
ZEEP_WALLET_BIRTHDAY_HEIGHT=0
ZEEP_RESERVE_UA=                  # [new] rpc backend: account UA to send from (defaults to ZEEP_RECEIVE_UA)
WALLET_RPC_URL=                   # [new] rpc backend: Zallet JSON-RPC on the VPS (TLS)
WALLET_RPC_USER=                  # [new]
WALLET_RPC_PASSWORD=              # [new] secret
WALLET_PRIVACY_POLICY=AllowRevealedAmounts   # [new]
MIN_CONFIRMATIONS=3
ADDRESS_POOL_MIN=25               # fresh deposit addresses kept ready
RESERVE_HOT_CAP_ZATS=500000000
POLL_SECS=                        # [new] worker loop interval (watcher 20, payouts 10)
DEV_BLOCK_SECS=75                 # [new] dev backend only
DEV_GENESIS_UNIX=1760000000       # [new] dev backend only

# --- Balances, prices and the spend circuit ---
# Two balances: dollar notes (micro-USD) and ZEC notes (zats). Credits show their total dollar value.
MICRO_USD_PER_CREDIT=1000000      # 1 credit = $1
ZEC_SHARE_BPS=5000                # [new] each deposit: 50% stays ZEC (user carries the price), 50% → dollars
REFILL_AT_BPS=500                 # [new] refill dollars when they fall to 5% of the last top-up...
REFILL_BPS=5000                   # [new] ...by converting 50% of the ZEC balance
REFILL_FINAL_STAGE=3              # [new] stage 3 converts all remaining ZEC
MIN_CONVERT_ZATS=10000            # [new]
CONVERT_QUOTE_TOLERANCE_BPS=100   # [new] a refill's proposed amount may be up to 1% under the live quote
MIN_DEPOSIT_ZATS=100000
DEPOSIT_INTENT_TTL_HOURS=72
ZEC_USD_FALLBACK=50
PRICE_REFRESH_SEC=300
SERVICE_PRICES_USD_JSON={"search":0.01,"research":0.25,"health":0.005,"rpc100":0.002,"inbox":0.30}
# MODELS_JSON=[{"id":"gpt-oss-20b","name":"GPT-OSS 20B","host":"zeep","usd":0.002,"detail":"Open weights"}, ...]
DEFAULT_MODEL=gpt-oss-20b
ATTACHMENT_USD_PER_MB=0.01
CHAT_MAX_BODY_MB=20
NOTE_TREE_DEPTH=20
NOTE_ROOT_HISTORY=200
SPEND_VKEY_URL=
SPEND_VKEY_PATH=circuits/zeep_spend_vkey.json
SPEND_VKEY_SHA256=
SPEND_WASM_URL=/circuits/zeep_spend.wasm
SPEND_ZKEY_URL=/circuits/zeep_spend.zkey
SPEND_ZKEY_SHA256=
TESTNET_MAX_DEPOSIT_ZATS_PER_DAY=20000000
VAULT_MAX_ITEM_KB=512
VAULT_MAX_ITEMS=2000

# --- Fees ---
PRICE_MARKUP_BPS=450              # services: upstream price + 4.5%
DEPOSIT_FEE_BPS=150               # ZEC -> dollars (the converted half of deposits, refills): pays ZEC -> USDC -> Tempo, with a margin
WITHDRAWAL_FEE_BPS=150            # dollars -> ZEC (credits converted in a withdrawal): pays Tempo -> USDC -> ZEC, with a margin
PROFIT_FLOOR_BPS=100              # covered network fees stop if profit would drop below 1% of volume
FREE_FEE_MIN_MICRO_USD=1000000    # deposits/withdrawals under $1 never get covered network fees
SUBSIDY_WINDOW_DAYS=7
SUBSIDY_BOOTSTRAP_MICRO_USD=2500000   # $2.50 launch allowance for covered network fees

# --- Withdrawals ---
MIN_WITHDRAWAL_MICRO_USD=1000000  # $1
TRANCHE_GAP_SEC=600               # second tranche 10 min after the first
REFUND_JITTER_SEC=180
REFUND_SPLIT_BPS=5000
REFUND_NETWORK_FEE_ZATS=10000     # per payout transaction
PAYOUT_ADDR_ENC_KEY=              # openssl rand -base64 32

# --- Treasury and NEAR Intents ---
NEAR_ONECLICK_BASE_URL=https://1click.chaindefuser.com
NEAR_ONECLICK_JWT=
TREASURY_SWAP_ORIGIN_ASSET=nep141:zec.omft.near   # [new]
TREASURY_SWAP_DEST_ASSET=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near   # USDC on Base
TREASURY_REFUND_TO=               # defaults to ZEEP_RESERVE_TADDR (NEAR Intents: transparent only)
TREASURY_SLIPPAGE_BPS=100
RESERVE_COVERAGE_MIN_BPS=10000

# --- Tempo float ---
FLOAT_MODE=off                    # auto: convert ZEC not owed to ZEC notes into USDC.e; withdrawals convert credits back
FLOAT_TICK_SEC=60
ZEC_FLOOR_ZATS=200000             # treasury ZEC fee buffer (covered network fees); refills from new deposits
CONVERSION_MIN_ZATS=100000
TREASURY_RAILS=mock               # live: NEAR Intents + Relay with TEMPO_PRIVATE_KEY; mock: simulated
ZEEP_RESERVE_TADDR=               # reserve transparent address: NEAR Intents returns ZEC here (auto-shielded)
SHIELD_MIN_ZATS=100000            # payouts worker shields transparent funds above this
BASE_RPC_URL=https://mainnet.base.org
RELAY_API_URL=https://api.relay.link

# --- MPP and Tempo ---
MPP_ENABLED=true
MPP_MODE=mock
TEMPO_PRIVATE_KEY=
TEMPO_RPC_URL=
MPP_SESSION_MAX_USD=20
MPP_DAILY_BUDGET_USD=5
MPP_OPENROUTER_URL=https://openrouter.mpp.tempo.xyz
MPP_ANTHROPIC_URL=https://anthropic.mpp.tempo.xyz
MPP_OPENAI_URL=https://openai.mpp.tempo.xyz
MPP_EXA_URL=https://api.exa.ai
MPP_BRAVE_URL=https://brave.mpp.paywithlocus.com
MPP_PARALLEL_URL=https://parallelmpp.dev
MPP_RXATLAS_URL=https://api.rxatlas.dev
MPP_TRIALBASE_URL=https://api.trialbase-db.org
MPP_ALCHEMY_URL=https://mpp.alchemy.com
MPP_QUICKNODE_URL=https://mpp.quicknode.com
MPP_STABLEEMAIL_URL=https://stableemail.dev
MPP_AGENTMAIL_URL=https://mpp.api.agentmail.to
RPC_ROUTES_JSON={"ethereum":"{alchemy}/eth-mainnet","base":"{alchemy}/base-mainnet","solana":"{quicknode}/solana-mainnet"}   # [new]
INBOX_PROVIDER=stableemail        # [new] stableemail | agentmail

# --- Self-hosted models (Modal) ---
MODAL_LLM_BASE_URL=
MODAL_PROXY_TOKEN=                # "wk-…:ws-…" → Modal-Key/Modal-Secret headers; otherwise Bearer
