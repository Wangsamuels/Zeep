# web, treasury and the release phase (migrations)
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-slim
# curl: Heroku streams release-phase output with it (`heroku releases:output` needs it).
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app
COPY package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY migrations ./migrations
# The spend verifying key (SPEND_VKEY_PATH=circuits/zeep_spend_vkey.json, pinned by SPEND_VKEY_SHA256).
COPY circuits/zeep_spend_vkey.json ./circuits/zeep_spend_vkey.json
USER node
CMD ["node", "dist/server.js"]
